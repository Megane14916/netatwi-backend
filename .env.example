# ================================================
# ネタツイグランプリ バックエンド 環境設定ファイル
# ================================================
# このファイルを .env にコピーして使用してください。
# .env ファイルは .gitignore に含まれています。

# ================================================
# Flask設定
# ================================================
FLASK_APP=app.py

# ローカル開発時は True に設定
# 本番環境では設定しないか False に設定
FLASK_DEBUG=True

# ================================================
# データベース設定
# ================================================
# ローカル開発時: SQLite
SQLALCHEMY_DATABASE_URI=sqlite:///project.db

# 本番環境（Neon PostgreSQL）の例:
# SQLALCHEMY_DATABASE_URI=postgresql://user:password@host/database?sslmode=require

# ================================================
# セキュリティ設定
# ================================================
# セッション管理用の秘密鍵（本番では複雑なランダム文字列を使用）
SECRET_KEY=your-very-secret-key-change-this

# ================================================
# フロントエンドURL
# ================================================
# ローカル開発時
FRONTEND_URL=http://localhost:3000

# 本番環境の例:
# FRONTEND_URL=https://your-frontend.vercel.app

# ================================================
# バックエンドURL（本番環境用）
# ================================================
# Cloud Run のURL（本番環境でのみ設定）
# GCR_URL=https://your-backend.run.app

# ================================================
# X (Twitter) OAuth認証
# ================================================
# X Developer Portalから取得したキーを設定
X_CONSUMER_KEY=your-consumer-key
X_CONSUMER_SECRET=your_x_consumer_secret

# 管理者として許可するXアカウントのscreen_name（カンマ区切り）
ADMIN_SCREEN_NAMES=dummy_admin1,dummy_admin2

# ================================================
# Cloudflare R2 ストレージ（オプション）
# ================================================
# 画像をR2に保存する場合は True に設定
USE_R2=False

# R2を使用する場合の設定:
# R2_BUCKET_NAME=your-bucket-name
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
# R2_ENDPOINT_URL=https://xxxxx.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key

# ================================================
# Google Cloud Tasks �ݔJE
# ================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=asia-northeast1
GCP_QUEUE_NAME=netatwi-contest-queue
TASK_HANDLER_URL=https://your-backend.run.app

